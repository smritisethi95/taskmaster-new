# Server
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskmaster?retryWrites=true&w=majority
MONGODB_URI=

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# File Uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads

# Gemini AI (Optional - add key to enable AI task descriptions & summaries)
GEMINI_API_KEY=
